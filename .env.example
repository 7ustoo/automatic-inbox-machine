# Copy to .env and fill in. .env is gitignored — never commit it.
# Everything here is optional except the transport credentials for your accounts.

# ---------------------------------------------------------------------------
# Telegram (recommended alert + chat channel)
# Create a bot: open Telegram -> @BotFather -> /newbot -> copy the token here.
# You do NOT need to find your chat ID by hand; run `npm run dashboard` and
# scan the QR code, or send /start to your bot and it pairs automatically.
# ---------------------------------------------------------------------------
TG_TOKEN=

# ---------------------------------------------------------------------------
# Claude classifier (optional). Without it the agent runs rules-only, which
# still catches rejections, ACKs, RTR/rate requests and interview language.
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Gmail API transport (per-account OAuth, installed-app + PKCE).
# One client is shared by all Gmail accounts. Create at:
#   console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Desktop app
# Enable the Gmail API, and add scopes gmail.modify + gmail.send.
# IMPORTANT: set the OAuth app's publishing status to "In production", not
# "Testing" — test-user refresh tokens expire every 7 days and will kill a
# 24/7 watcher. You will click through one "unverified app" warning.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# IMAP/SMTP transport (per account, app passwords).
# Suffix each var with the UPPERCASED account id from config.json.
# Example for an account with "id": "primary":
#   IMAP_PASSWORD_PRIMARY=xxxx xxxx xxxx xxxx
#   SMTP_PASSWORD_PRIMARY=xxxx xxxx xxxx xxxx
# If SMTP_PASSWORD_* is omitted the IMAP password is reused.
# For Gmail app passwords you must have 2FA enabled on the account.
# ---------------------------------------------------------------------------
# IMAP_PASSWORD_PRIMARY=
# SMTP_PASSWORD_PRIMARY=

# ---------------------------------------------------------------------------
# ntfy.sh (optional zero-account phone push — alerts only, no conversation)
# Pick an unguessable topic name; anyone who knows it can read your alerts.
# ---------------------------------------------------------------------------
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Optional generic webhook sink (Discord/Slack incoming webhook URL, etc.)
WEBHOOK_URL=
