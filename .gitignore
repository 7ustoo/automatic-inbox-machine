# Secrets — never commit
.env
.env.local
google-oauth-client.json
*-token.json
tokens/

# User state
config.json
data/
logs/

# Private notes
*PRIVATE*.md
CONTEXT-PRIVATE.md

# Go wrapper build output. logo.ico / logo.png ARE committed — they are generated
# but the Go build embeds them, so a checkout has to contain them.
wrapper/dist/
wrapper/*.syso

# Node
node_modules/
npm-debug.log*
.npm/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.idea/
*.swp
